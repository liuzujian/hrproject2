<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.lzj.hrsys_lzj49.dao.EmployeeDao">

    <!-- 多条件组合查询 -->
    <select id="search" parameterType="org.lzj.hrsys_lzj49.entity.Employee" resultType="org.lzj.hrsys_lzj49.entity.Employee">
        SELECT * FROM employee
        WHERE 1=1
        <if test="name != null and name != ''">
            AND name LIKE CONCAT('%', #{name}, '%')
        </if>
        <if test="gender != null and gender != ''">
            AND gender = #{gender}
        </if>
        <if test="age != null">
            AND age = #{age}
        </if>
        <if test="dep != null and dep.id != null">
            AND dep_id = #{dep.id}
        </if>
    </select>

    <!-- 根据ID查询 -->
    <select id="searchById" resultType="org.lzj.hrsys_lzj49.entity.Employee">
        SELECT * FROM employee WHERE id = #{id}
    </select>

    <!-- 添加员工 -->
    <insert id="add" parameterType="org.lzj.hrsys_lzj49.entity.Employee">
        INSERT INTO employee (number, name, gender, age, dep_id)
        VALUES (#{number}, #{name}, #{gender}, #{age}, #{dep.id})
    </insert>

    <!-- 更新员工 -->
    <update id="update" parameterType="org.lzj.hrsys_lzj49.entity.Employee">
        UPDATE employee
        SET number = #{number}, name = #{name}, gender = #{gender}, age = #{age}, dep_id = #{dep.id}
        WHERE id = #{id}
    </update>

    <!-- 删除员工 -->
    <delete id="delete" parameterType="int">
        DELETE FROM employee WHERE id = #{id}
    </delete>

    <!-- 批量更新部门下的员工 -->
    <update id="updateByDep" parameterType="int">
        UPDATE employee SET dep_id = #{depId} WHERE dep_id = #{depId}
    </update>

</mapper>