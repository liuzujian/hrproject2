<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.lzj.hrsys_lzj49.dao.DepartmentDao">

    <!-- 结果映射 -->
    <resultMap id="DepartmentMap" type="org.lzj.hrsys_lzj49.entity.Department">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="number" column="number"/>
    </resultMap>

    <!-- 查询所有 -->
    <select id="search" resultMap="DepartmentMap">
        SELECT id, name, number
        FROM department;
    </select>

    <!-- 根据ID查询 -->
    <select id="searchById" parameterType="int" resultMap="DepartmentMap">
        SELECT id, name, number
        FROM department
        WHERE id = #{id};
    </select>

    <!-- 新增部门 -->
    <insert id="add" parameterType="org.lzj.hrsys_lzj49.entity.Department">
        INSERT INTO department (name, number)
        VALUES (#{name}, #{number});
    </insert>

    <!-- 更新部门 -->
    <update id="update" parameterType="org.lzj.hrsys_lzj49.entity.Department">
        UPDATE department
        SET name = #{name},
            number = #{number}
        WHERE id = #{id};
    </update>

    <!-- 删除部门 -->
    <delete id="delete" parameterType="int">
        DELETE FROM department
        WHERE id = #{id};
    </delete>

</mapper>
